{
  "manifest_version": 3,
  "name": "StayCheck",
  "version": "1.0.0",
  "description": "Shows a Google Maps review check on Booking.com, Agoda, and Expedia property pages.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://staycheck-api.msannan121.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "StayCheck", "default_popup": "popup.html" },
  "web_accessible_resources": [{
    "resources": ["assets/icon-16.png", "assets/icon-32.png", "assets/icon-48.png", "assets/icon-128.png"],
    "matches": ["https://*.booking.com/*", "https://*.agoda.com/*", "https://*.expedia.com/*", "https://*.expedia.co.in/*", "https://*.expedia.co.uk/*", "https://*.expedia.ca/*", "https://*.expedia.com.au/*"]
  }],
  "content_scripts": [{
    "matches": [
      "https://www.booking.com/hotel/*",
      "https://*.booking.com/hotel/*",
      "https://www.agoda.com/*/hotel/*",
      "https://*.agoda.com/*/hotel/*",
      "https://www.expedia.com/*.Hotel-Information*",
      "https://www.expedia.co.in/*.Hotel-Information*",
      "https://www.expedia.co.uk/*.Hotel-Information*",
      "https://www.expedia.ca/*.Hotel-Information*",
      "https://www.expedia.com.au/*.Hotel-Information*"
    ],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
